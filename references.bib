}

@article{vanderweele2008causal,
  title = {Causal Directed Acyclic Graphs and the Direction of Unmeasured Confounding Bias},
  author = {VanderWeele, Tyler J. and Hern{\'a}n, Miguel A. and Robins, James M.},
