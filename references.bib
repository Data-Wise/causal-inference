  keywords = {Bias,Causality,Computer Simulation,Confounding Factors Epidemiologic,Data Interpretation Statistical,Effect decomposition,Effect Modifier Epidemiologic,Epidemiologic Studies,G-computation,Humans,Mediation analysis,Models Statistical,Monte Carlo Method,Parametric g-formula,Regression Analysis,Root Cause Analysis,Simulation,Smoking},
  annotation = {GSCC: 0000119 2025-10-09T22:47:29.199Z 0.23 \\
TLDR: The utility of parametric g-computation is demonstrated in estimating various components of the total effect, including natural direct and indirect effects, standard and stochastic controlled direct effects, and reference and mediated interaction effects, using Monte Carlo simulations in standard statistical software.},
