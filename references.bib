@article{loh2022improving,
  title = {Improving Causal Inference of Mediation Analysis with Multiple Mediators Using Interventional Indirect Effects},
  author = {Loh, Wen Wei and Ren, Dongning},
  year = 2022,
  journal = {Social and Personality Psychology Compass},
